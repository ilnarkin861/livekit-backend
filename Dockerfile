# Используем официальный легкий образ Node.js на базе Alpine Linux
FROM node:20-alpine

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файлы манифеста зависимостей
COPY package*.json ./

# Устанавливаем только необходимые для продакшена зависимости
RUN npm ci --only=production

# Копируем исходный код приложения
COPY . .

# Открываем порт, на котором работает Express
EXPOSE 3000

# Команда для запуска приложения
CMD ["node", "server.js"]
